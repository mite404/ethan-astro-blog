---
// Test page: hover each bat zone's grid to briefly reveal the matching piece of the
// homepage bat texture (mimics Render's "spinning up" hover grid).
import batTopImg from '@/images/BAT_TOP_CROPPED_FIXED.png'
import batBottomImg from '@/images/BAT_BOTTOM_CROPPED.png'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Bat grid test</title>
    <style>
      body {
        margin: 0;
        background: #fff;
      }
      /* Same box as the homepage zones: full width up to 1280px, at the asset's own ratio */
      canvas {
        display: block;
        width: min(100%, 1280px);
        margin: 0 auto;
      }
    </style>
  </head>
  <body>
    <canvas
      data-src={batTopImg.src}
      style={`aspect-ratio: ${batTopImg.width} / ${batTopImg.height}`}></canvas>
    <canvas
      data-src={batBottomImg.src}
      style={`aspect-ratio: ${batBottomImg.width} / ${batBottomImg.height}`}></canvas>
    <script>
      const CELL = 64 // px, one grid square
      const HOLD = 660 // ms a tile stays fully drawn
      const FADE = 1540 // ms to fade out after HOLD
      const MAX_TILES = 200 // per zone; oldest tiles get dropped past this

      const setup = (canvas: HTMLCanvasElement) => {
        const ctx = canvas.getContext('2d')!
        const img = new Image()
        img.src = canvas.dataset.src!
        // key "col,row" → birth time; Map keeps insertion order, so the first entry is the oldest
        const tiles = new Map<string, number>()
        let w = 0
        let h = 0

        const resize = () => {
          const dpr = window.devicePixelRatio || 1
          w = canvas.clientWidth
          h = canvas.clientHeight
          canvas.width = w * dpr
          canvas.height = h * dpr
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
          ctx.imageSmoothingEnabled = false
        }

        // Draw the texture under cell (col,row), scaled like `object-fit: cover; center top`.
        const drawTile = (col: number, row: number) => {
          const scale = Math.max(w / img.width, h / img.height) // canvas px per image px
          const offsetX = (img.width * scale - w) / 2
          ctx.drawImage(
            img,
            (col * CELL + offsetX) / scale,
            (row * CELL) / scale,
            CELL / scale,
            CELL / scale,
            col * CELL,
            row * CELL,
            CELL,
            CELL
          )
        }

        const drawGrid = () => {
          ctx.strokeStyle = '#eee'
          ctx.lineWidth = 1
          ctx.beginPath()
          for (let x = 0.5; x < w; x += CELL) {
            ctx.moveTo(x, 0)
            ctx.lineTo(x, h)
          }
          for (let y = 0.5; y < h; y += CELL) {
            ctx.moveTo(0, y)
            ctx.lineTo(w, y)
          }
          ctx.stroke()
        }

        const frame = (now: number) => {
          ctx.clearRect(0, 0, w, h)
          drawGrid()
          for (const [key, born] of tiles) {
            const a = 1 - Math.max(0, now - born - HOLD) / FADE
            if (a <= 0) {
              tiles.delete(key)
              continue
            }
            const [col, row] = key.split(',').map(Number)
            ctx.globalAlpha = a
            drawTile(col, row)
          }
          ctx.globalAlpha = 1
          requestAnimationFrame(frame)
        }

        const onMove = (e: PointerEvent) => {
          const key = `${Math.floor(e.offsetX / CELL)},${Math.floor(e.offsetY / CELL)}`
          if (tiles.has(key)) return
          tiles.set(key, performance.now())
          if (tiles.size > MAX_TILES) tiles.delete(tiles.keys().next().value!)
        }

        img.onload = () => {
          resize()
          addEventListener('resize', resize)
          canvas.addEventListener('pointermove', onMove)
          requestAnimationFrame(frame)
        }
      }

      document.querySelectorAll('canvas').forEach(setup)
    </script>
  </body>
</html>
