---
import '@/styles/global.css'
import BaseLayout from '@/layouts/BaseLayout.astro'
import BaseHead from '@/components/layout/BaseHead.astro'
import PortfolioHeader from '@/components/layout/PortfolioHeader.astro'

const { title, description } = Astro.props
---

<BaseLayout type="portfolio">
  <BaseHead slot="head" title={title} description={description} />
  <div class="portfolio-layout">
    <PortfolioHeader />
    <main class="portfolio-main">
      <slot />
    </main>
  </div>
</BaseLayout>

<style is:global>
  /* Portfolio-specific body styles - dark theme matching Figma design */
  body[data-layout-type='portfolio'] {
    padding: 0;
    max-width: none;
    margin: 0 auto;
    background-color: #1c1c1c !important;
  }

  html:has(body[data-layout-type='portfolio']) {
    background-color: #1c1c1c !important;
  }

  .portfolio-layout {
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
    padding-inline: var(
      --gutter
    ); /* was a hardcoded 2rem — 001's placeholder, which 002 never replaced */
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding-top: 1rem;
    position: relative;
    overflow: hidden; /* Clip overflowing elements like the 1513px hand */
  }

  .portfolio-main {
    flex: 1;
    padding-bottom: 0.5rem;
    width: 100%;
  }
</style>
