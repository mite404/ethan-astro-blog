{
  // This project uses eslint + prettier only (repo ships its own
  // eslint.config.js / .prettierrc). oxlint/oxfmt are explicitly excluded
  // here, overriding the global oxc preference.
  // Biome is excluded too: Zed's Astro frontmatter is classified as plain
  // JavaScript/TypeScript, so Biome auto-attaches there with no biome.json
  // present unless "!biome" is listed (biomejs/biome-zed#155).
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "prettier": { "allowed": true },
      "language_servers": ["vtsls", "eslint", "!oxlint", "!oxfmt", "!biome"],
      "formatter": ["prettier", { "code_action": "source.fixAll.eslint" }]
    },
    "TypeScript": {
      "format_on_save": "on",
      "prettier": { "allowed": true },
      "language_servers": ["vtsls", "eslint", "!oxlint", "!oxfmt", "!biome"],
      "formatter": ["prettier", { "code_action": "source.fixAll.eslint" }]
    },
    "TSX": {
      "format_on_save": "on",
      "prettier": { "allowed": true },
      "language_servers": ["vtsls", "eslint", "!oxlint", "!oxfmt", "!biome"],
      "formatter": ["prettier", { "code_action": "source.fixAll.eslint" }]
    }
  }
}
